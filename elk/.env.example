# Copy to .env (git-ignored) and fill in. Never commit .env.

# Use the latest Elastic 9.x release: https://www.elastic.co/downloads/elasticsearch
STACK_VERSION=9.1.0
CLUSTER_NAME=homelab

# Letters and digits only; the setup script embeds them in JSON without escaping.
ELASTIC_PASSWORD=
KIBANA_PASSWORD=

# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Hostname and IP agents use to reach elk01; both go into the TLS certificates.
ELK_FQDN=elk01.example.lan
ELK_IP=192.168.20.10

# 6 GB VM: ES 3 GB (2 GB heap) + Kibana 1 GB + Fleet Server and OS in the rest.
ES_HEAP=2g
ES_MEM_LIMIT=3g
KIBANA_MEM_LIMIT=1g
